<?xml version="1.0"?>
<!--
  Differential-drive indoor cleaning robot (Roomba-sized, ~34 cm diameter).

  Frames:
    base_footprint  - on the ground, under the robot centre (SLAM base_frame)
    base_link       - at wheel-axle height
    left/right_wheel_link, front/rear_caster_link
    lidar_link      - 2D LiDAR on top (~11.5 cm above floor, so it sees
                      table and chair legs, like a real robot vacuum)
    imu_link

  Gazebo Sim (Harmonic) plugins are in cleaning_robot.gazebo.xacro.
-->
<robot name="cleaning_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Parameters ===================== -->
  <xacro:property name="PI" value="3.14159265359"/>

  <xacro:property name="chassis_radius" value="0.17"/>
  <xacro:property name="chassis_height" value="0.08"/>
  <xacro:property name="chassis_mass"   value="3.0"/>

  <xacro:property name="wheel_radius"     value="0.035"/>
  <xacro:property name="wheel_width"      value="0.02"/>
  <xacro:property name="wheel_separation" value="0.24"/>
  <xacro:property name="wheel_mass"       value="0.2"/>

  <xacro:property name="caster_radius" value="0.015"/>
  <xacro:property name="caster_offset_x" value="0.13"/>
  <xacro:property name="caster_mass"   value="0.05"/>

  <!-- Chassis bottom sits 1.5 cm above the floor -->
  <xacro:property name="ground_clearance" value="0.015"/>
  <xacro:property name="chassis_z" value="${ground_clearance - wheel_radius + chassis_height / 2}"/>

  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.04"/>

  <!-- ===================== Inertia macros ===================== -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m * (3 * r * r + h * h) / 12}" ixy="0" ixz="0"
             iyy="${m * (3 * r * r + h * h) / 12}" iyz="0"
             izz="${m * r * r / 2}"/>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2 * m * r * r / 5}" ixy="0" ixz="0"
             iyy="${2 * m * r * r / 5}" iyz="0"
             izz="${2 * m * r * r / 5}"/>
  </xacro:macro>

  <!-- ===================== Materials ===================== -->
  <material name="white"><color rgba="0.92 0.92 0.92 1.0"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1.0"/></material>
  <material name="blue"><color rgba="0.10 0.35 0.80 1.0"/></material>

  <!-- ===================== Links & joints ===================== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><cylinder radius="${chassis_radius}" length="${chassis_height}"/></geometry>
      <material name="white"/>
    </visual>
    <!-- small "front" marker so heading is visible in Gazebo/RViz -->
    <visual>
      <origin xyz="${chassis_radius - 0.03} 0 ${chassis_z + chassis_height / 2}" rpy="0 0 0"/>
      <geometry><box size="0.03 0.08 0.004"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><cylinder radius="${chassis_radius}" length="${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <xacro:cylinder_inertia m="${chassis_mass}" r="${chassis_radius}" h="${chassis_height}"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Drive wheels. Both joints rotate about +Y, so positive velocity = forward. -->
  <xacro:macro name="drive_wheel" params="side y_sign">
    <link name="${side}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y_sign * wheel_separation / 2} 0" rpy="${-PI / 2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left"  y_sign="1"/>
  <xacro:drive_wheel side="right" y_sign="-1"/>

  <!-- Frictionless casters (front and rear) keep the robot level -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="${caster_mass}"/>
        <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
      </inertial>
    </link>

    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster name="front" x="${caster_offset_x}"/>
  <xacro:caster name="rear"  x="${-caster_offset_x}"/>

  <!-- 2D LiDAR on top of the chassis -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <xacro:cylinder_inertia m="0.1" r="${lidar_radius}" h="${lidar_height}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${chassis_z + chassis_height / 2 + lidar_height / 2}" rpy="0 0 0"/>
  </joint>

  <!-- IMU inside the chassis -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Gazebo Sim plugins & sensors ===================== -->
  <xacro:include filename="$(find cleaning_robot_description)/urdf/cleaning_robot.gazebo.xacro"/>
  <xacro:cleaning_robot_gazebo wheel_separation="${wheel_separation}" wheel_radius="${wheel_radius}"/>

</robot>
